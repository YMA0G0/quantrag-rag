# but do not include unexpected files inside it.
data/index/*
!data/index/manifest.json
!data/index/chunks.jsonl
!data/index/vectors.json
!data/index/embedder.json
data/ingest_report.json
data/ingest_report.csv
data/ingest_report.dryrun.json
data/ingest_report.dryrun.csv

# Manual source documents (large, licence-unclear)
data/manual/*
!data/manual/README.md

# --- Local staging and rollback artefacts ---
data/staging/
data/.quantrag_index_rollback_*
data/.quantrag_index_stage_*
data/.quantrag_candidate_prepared_*
