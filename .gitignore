# --- Secrets / local configuration ---
.env
.env.*
!.env.example

# --- Virtual environments ---
.venv/
venv/
env/

# --- Build / download artefacts ---
*.zip
new*.zip
quantrag_*.zip
pdfs/

# --- Python caches / build artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Ingestion artefacts ---
data/raw/
data/chunks.jsonl
