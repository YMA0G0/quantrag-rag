# --- QuantRAG configuration (copy to .env and fill in) ---
# .env is git-ignored. Never commit real credentials.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=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

# Required: the OpenRouter model id to use, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: override the API base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: request timeout in seconds (default: 60)
# OPENROUTER_TIMEOUT_SECONDS=60

# Optional: cap on the completion length in tokens (default: 1024).
# Bounding this caps the credit reserved per request.
# OPENROUTER_MAX_TOKENS=1024

# Optional: app identification sent to OpenRouter (X-Title / HTTP-Referer)
# OPENROUTER_APP_NAME=QuantRAG
# OPENROUTER_APP_URL=https://example.com

# Optional: OpenRouter embedding model used to build/search the vector index
# (required only for index building / RAG retrieval)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- QuantRAG REST API authentication ---
# Server-side secret: comma-separated list of individually issued keys.
# The operator issues one key per authorized MCP user.
QUANTRAG_API_KEYS=

# Per-user key configured in the MCP client's environment/config.
# The MCP server forwards this value in the X-API-Key header.
QUANTRAG_API_KEY=

# REST API URL (used by MCP server when forwarding via HTTP)
QUANTRAG_API_URL=
# Set to 1 in any shared/cloud deployment: startup fails unless at least one
# key is present in QUANTRAG_API_KEYS. Leave empty/0 for local development.
QUANTRAG_REQUIRE_AUTH=
